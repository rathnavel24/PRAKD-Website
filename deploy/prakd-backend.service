[Unit]
Description=Prakd enquiry backend (FastAPI)
After=network.target

[Service]
User=rat
WorkingDirectory=/home/rat/apps/prakd-site/backend
ExecStart=/home/rat/apps/prakd-site/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8788 --no-access-log
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# Optional Telegram alert per enquiry: TELEGRAM_CHAT and TELEGRAM_TOKEN_FILE go in deploy/local.env (not in git)
EnvironmentFile=-/home/rat/apps/prakd-site/deploy/local.env
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/rat/apps/prakd-site/backend/data

[Install]
WantedBy=multi-user.target
